# Airtable Personal Access Token (PAT)
# Generate from: https://airtable.com/create/tokens
# Required Scopes:
#   - data.records:read
#   - data.records:write
#   - data.recordComments:read
#   - data.recordComments:write
#   - schema.bases:read
#   - schema.bases:write
#   - webhook:manage
#   - block:manage
AIRTABLE_API_KEY=pat_your_airtable_token_here

# Airtable Base ID (Created automatically via `npm run seed` or copy from URL: appXXXXXXXXXXXXXX)
AIRTABLE_BASE_ID=appEnterpriseShowcase01

# Airtable Workspace ID
AIRTABLE_WORKSPACE_ID=wsp3p16CPCotJVZdX

# Webhook Server Configuration
PORT=3000
WEBHOOK_SECRET=your_airtable_webhook_hmac_secret_here
WEBHOOK_NOTIFICATION_URL=https://your-domain.ngrok-free.app/api/webhooks/airtable

# Optional: LLM Enrichment Configuration (for AI scripting automations)
