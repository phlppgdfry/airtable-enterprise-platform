{
  "name": "airtable-enterprise-platform",
  "version": "1.0.0",
  "description": "Enterprise-grade Airtable platform showcase: Custom Extensions SDK, Metadata API migrations, real-time Webhook CDC engine, high-performance batch upsert, scripting automations & MCP integration",
  "author": "Philippe Godfroy <philippe@example.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "airtable-toolkit": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "cli": "tsx src/cli/index.ts",
    "provision": "tsx src/cli/index.ts provision",
    "formula": "tsx src/cli/index.ts formula",
    "seed": "tsx src/cli/index.ts seed",
    "schema:export": "tsx src/cli/index.ts schema:export",
    "audit": "tsx src/cli/index.ts audit",
    "webhook:listen": "tsx src/webhooks/server.ts",
    "block:run": "block run",
    "block:release": "block release"
  },
  "dependencies": {
    "@airtable/blocks": "^1.19.0",
    "airtable": "^0.12.2",
    "axios": "^1.8.1",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ora": "^5.4.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "table": "^6.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@airtable/blocks-cli": "^3.0.3",
    "@airtable/blocks-testing": "^0.0.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/react": "^17.0.80",
    "@types/react-dom": "^17.0.26",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "airtable",
    "airtable-blocks",
    "airtable-extension",
    "metadata-api",
    "webhooks",
    "automation",
    "enterprise-architecture",
    "mcp",
    "typescript"
  ]
}
